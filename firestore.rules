rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /huishoudboekjes/{bookId} {
      function isMember() {
        return request.auth != null &&
          (resource.data.ownerUid == request.auth.uid ||
           request.auth.uid in resource.data.members);
      }

      function isOwner() {
        return request.auth != null &&
          resource.data.ownerUid == request.auth.uid;
      }

      allow read: if isMember();
      allow create: if request.auth != null;
      allow update, delete: if isOwner();

      match /transactions/{transactionId} {
        function bookIsMember() {
          let book = get(/databases/$(database)/documents/huishoudboekjes/$(bookId));
          return request.auth != null &&
            (book.data.ownerUid == request.auth.uid ||
             request.auth.uid in book.data.members);
        }

        function bookIsOwner() {
          let book = get(/databases/$(database)/documents/huishoudboekjes/$(bookId));
          return request.auth != null &&
            book.data.ownerUid == request.auth.uid;
        }

        allow read: if bookIsMember();
        allow write: if bookIsOwner();
      }

      match /categories/{categoryId} {
        function bookIsMember() {
          let book = get(/databases/$(database)/documents/huishoudboekjes/$(bookId));
          return request.auth != null &&
            (book.data.ownerUid == request.auth.uid ||
             request.auth.uid in book.data.members);
        }

        function bookIsOwner() {
          let book = get(/databases/$(database)/documents/huishoudboekjes/$(bookId));
          return request.auth != null &&
            book.data.ownerUid == request.auth.uid;
        }

        allow read: if bookIsMember();
        allow write: if bookIsOwner();
      }
    }
  }
}
